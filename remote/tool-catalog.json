[
  {
    "name": "tasker_identity",
    "title": "Connected account",
    "description": "Read the connected account, permission grants and quotas. Start here; never ask for a password or token.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "scopes": [],
    "route": "me"
  },
  {
    "name": "tasker_capabilities",
    "title": "Available actions",
    "description": "Discover the current permitted collections and commands. Do not assume paid or coach access.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "scopes": [],
    "route": "capabilities"
  },
  {
    "name": "tasker_projects",
    "title": "Find projects",
    "description": "List one authorized page. Follow nextAfter even when the page is empty. Read only items relevant to the user request.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scopes": ["projects:read"],
    "route": "projects"
  },
  {
    "name": "tasker_memories",
    "title": "Find memories and graphs",
    "description": "List independent memories and graphs available to this connection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scopes": ["memory:read"],
    "route": "memories"
  },
  {
    "name": "tasker_resources",
    "title": "Read records",
    "description": "Read a bounded page or exact record before modifying it. Preserve epoch/revision. Never crawl all collections. Use personal scope only for the connected owner; revoked access is unavailable. Prefer the permission-specific read tools for new calls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "collection": {
          "type": "string",
          "enum": [
            "assets",
            "comments",
            "documentFolders",
            "documents",
            "edges",
            "filters",
            "gitHubLinks",
            "goals",
            "history",
            "members",
            "memory",
            "nodeIndex",
            "nodes",
            "pageIndex",
            "pages",
            "preparedLists",
            "project",
            "projectDocumentIndex",
            "projectDocuments",
            "questions",
            "schedules",
            "sprintHistory",
            "sprints",
            "tags",
            "taskTemplates",
            "tasks",
            "workflows"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "archive": {
          "type": "string",
          "enum": ["true", "false"]
        }
      },
      "required": ["scope", "collection"],
      "additionalProperties": false
    },
    "scopes": [],
    "route": "resources"
  },
  {
    "name": "tasker_knowledge",
    "title": "Search memory or graph",
    "description": "Search one memory or explore a bounded graph neighborhood; retrieve full pages only when needed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mode": {
          "type": "string",
          "enum": ["search", "graph"]
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "collection": {
          "type": "string",
          "enum": ["pages", "nodes"]
        },
        "center": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["scope", "mode"],
      "additionalProperties": false
    },
    "scopes": ["memory:read"],
    "route": "knowledge"
  },
  {
    "name": "tasker_memory_tree",
    "title": "Browse documentation folders",
