{
  "name": "@pulsarinteractive/geniustasker",
  "version": "0.1.0-beta.2",
  "private": false,
  "description": "GeniusTasker delegated CLI and local agent tools",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "geniustasker": "bin/geniustasker.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "docs/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "plugin.json",
    "mcp.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check-package.mjs && node tools/check-public.mjs && node tools/check-plugin.mjs",
    "prepublishOnly": "npm test && npm run check",
    "check:public": "node tools/check-public.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "open": "10.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "ajv": "8.20.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PulsarInteractive/geniustasker-agent-tools.git"
  },
  "homepage": "https://github.com/PulsarInteractive/geniustasker-agent-tools#readme",
  "bugs": {
    "url": "https://github.com/PulsarInteractive/geniustasker-agent-tools/issues"
  },
  "keywords": [
    "geniustasker",
    "mcp",
    "cli",
    "agent-skills",
    "codex"
  ]
}
